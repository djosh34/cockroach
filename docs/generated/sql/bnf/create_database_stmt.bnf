create_database_stmt ::=
	'CREATE' 'DATABASE' database_name ( 'WITH' |  ) opt_template_clause ( 'ENCODING' ( '=' |  ) encoding |  ) opt_lc_collate_clause opt_lc_ctype_clause ( 'CONNECTION' 'LIMIT' ( '=' |  ) limit |  ) opt_owner_clause
	| 'CREATE' 'DATABASE' 'IF' 'NOT' 'EXISTS' database_name ( 'WITH' |  ) opt_template_clause ( 'ENCODING' ( '=' |  ) encoding |  ) opt_lc_collate_clause opt_lc_ctype_clause ( 'CONNECTION' 'LIMIT' ( '=' |  ) limit |  ) opt_owner_clause
