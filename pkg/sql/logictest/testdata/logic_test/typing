# The result of CASE, COALESCE and IF keeps a type width only if every branch
# has it, so no branch is truncated to the width of another.
query TTTTTT
SELECT
  CASE WHEN false THEN 'a'::CHAR ELSE 'bbb' END,
  CASE WHEN false THEN 'a'::VARCHAR(1) ELSE 'abcd' END,
  COALESCE(NULL::CHAR, 'abcd'),
  COALESCE(NULL::CHAR(2), 'abcd'::CHAR(4)),
  IF(false, 'a'::CHAR, 'abcd'),
  IF(false, 'a'::VARCHAR(1), 'abcd')
----
bbb  abcd  abcd  abcd  abcd  abcd

query TT
SELECT
  CASE WHEN true THEN 'a'::CHAR ELSE 'bbb'::CHAR(3) END,
  COALESCE(NULL, 'ab'::CHAR(2), 'abcd')
